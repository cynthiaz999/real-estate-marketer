# Create a wide container box for Instagram
with st.container(border=True):
    st.subheader("📸 Post 1: Instagram (The Hook)")
    st.markdown("**✨ Urban Loft Living Awaits! ✨**")
    st.write("Step into your dream condo in the heart of downtown...")
    
    # Pro-tip: Add a convenient copy button right below the text!
    st.button("Copy Instagram Text", key="copy_ig")

# Space out the next platform
st.write("") 

# Create another container box for Facebook
with st.container(border=True):
    st.subheader("👥 Post 2: Facebook (The Story)")
    st.markdown("**🌟 Discover the Heart of Downtown Living! 🌟**")
    st.write("Welcome to your new urban sanctuary...")
    st.button("Copy Facebook Text", key="copy_fb")
